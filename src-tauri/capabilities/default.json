{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for every editor window. Extra windows are labeled paint-<id>, so the glob has to cover them or clipboard, dialogs, and file I/O are denied there.",
  "windows": ["main", "paint-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-destroy",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-write-image"
  ]
}

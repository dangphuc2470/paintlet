{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paint",
  "version": "0.1.4",
  "identifier": "com.microsoft.paint",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Paint",
        "width": 1100,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "maximized": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "GraphicsAndDesign",
    "publisher": "Bai Li",
    "homepage": "https://github.com/lucky-bai/paintlet",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "copyright": "© 2026 Bai Li",
    "shortDescription": "MS Paint-style image editor for macOS",
    "longDescription": "Paintlet is an MS Paint-style raster image editor for macOS: pencil, brush, shapes, flood fill, text, and selections in a native window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["png", "jpg", "jpeg", "bmp", "gif", "webp", "heic", "tiff", "ico", "svg"],
        "name": "Image File",
        "description": "Image File",
        "role": "Editor",
        "mimeType": "image/*"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
